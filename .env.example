# Database Configuration (REQUIRED)
DATABASE_URL="postgresql://username:password@host:port/database"
DIRECT_URL="postgresql://username:password@host:port/database"

# Authentication (REQUIRED)
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Email Service (Optional - for user activation emails)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="noreply@yourdomain.com"

# File Upload Service (Optional - for image uploads)
CLOUDFLARE_R2_ENDPOINT="your-r2-endpoint"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-key"
CLOUDFLARE_R2_BUCKET_NAME="your-bucket-name"
CLOUDFLARE_R2_REGION="auto"

# App Configuration (Optional - has defaults)
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Berjamaah POSKU Bandung"
NEXT_PUBLIC_LOGO_URL="/favicon.ico"

# Vercel Configuration (Optional - for production)
VERCEL_URL="yourdomain.com"

# Webhook Security (Optional - for GitHub Actions automation)
WEBHOOK_SECRET="your-webhook-secret-key"
PROCESS_SCHEDULED_ACTIVATION_USERS_WEBHOOK_URL="https://yourdomain.com/api/webhooks/process-scheduled-activation-users"
ACTIVATE_PROGRAMS_WEBHOOK_URL="https://yourdomain.com/api/webhooks/activate-programs"
DEACTIVATE_PROGRAMS_WEBHOOK_URL="https://yourdomain.com/api/webhooks/deactivate-programs"
