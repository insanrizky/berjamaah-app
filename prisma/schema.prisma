generator client {
  provider = "prisma-client-js"

  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  scheduled
  pending
  active
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  password          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  role              String            @default("user")
  fullName          String?           @map("full_name")
  phone             String?
  // Onboarding fields
  status            UserStatus        @default(scheduled)
  uniqueId          String?           @unique
  dob               DateTime?
  verifiedDonations Donation[]        @relation("VerifiedByAdmin")
  createdPrograms   Program[]         @relation("CreatedPrograms")
  bankAccounts      UserBankAccount[]

  @@index([status, createdAt])
  @@map("user")
}

// Custom verification tokens used by activation flow
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @unique
  expiresAt  DateTime @map("expires_at")

  @@map("verification")
}

model Donation {
  id                      String           @id @default(cuid())
  userId                  String?          @map("user_id")
  donorName               String           @map("donor_name")
  donorEmail              String           @map("donor_email")
  donorPhone              String?          @map("donor_phone")
  programId               String           @map("program_id")
  verifiedByAdminId       String?          @map("verified_by_admin_id")
  userBankAccountId       String?          @map("user_bank_account_id")
  amount                  Decimal          @db.Decimal(15, 2)
  status                  String           @default("pending_verification")
  paymentMethod           String?          @map("payment_method")
  verifiedAt              DateTime?        @map("verified_at")
  donationReferenceNumber String           @unique @map("donation_reference_number")
  donationProofImage      String?          @map("donation_proof_image")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  program                 Program          @relation(fields: [programId], references: [id])
  verifiedByAdmin         User?            @relation("VerifiedByAdmin", fields: [verifiedByAdminId], references: [id])
  userBankAccount         UserBankAccount? @relation(fields: [userBankAccountId], references: [id])

  @@map("donations")
}

model Program {
  id              String          @id @default(cuid())
  title           String
  description     String
  targetAmount    Decimal         @map("target_amount") @db.Decimal(15, 2)
  bannerImage     String?         @map("banner_image")
  category        String?
  status          String          @default("draft")
  contact         String?
  details         String?
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  donations       Donation[]
  createdByUser   User?           @relation("CreatedPrograms", fields: [createdBy], references: [id])

  @@map("programs")
}


model UserBankAccount {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  bankName      String     @map("bank_name")
  accountNumber String     @map("account_number")
  accountHolder String     @map("account_holder")
  isDefault     Boolean    @default(false) @map("is_default")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations     Donation[]

  @@unique([userId, accountNumber])
  @@index([userId])
  @@map("user_bank_accounts")
}
